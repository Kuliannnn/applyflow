# The migration command reads the process environment; it does not auto-load this file.
# Create the local database first. Never commit real passwords.
DATABASE_URL=postgresql://localhost/applyflow?sslmode=disable
# Integration tests create/drop only a random schema; the database name must end in _test.
TEST_DATABASE_URL=postgresql://localhost/applyflow_test?sslmode=disable

# API settings (export these in the process environment; no automatic .env loading).
APP_ENV=local
# Browser origin for the Vite frontend; must match hostname AND port exactly.
PUBLIC_ORIGIN=http://127.0.0.1:5173
HTTP_ADDR=127.0.0.1:8080
AUTH_TTL=30m
DB_MAX_CONNS=10
# Generate two DIFFERENT base64-encoded random keys, each at least 32 bytes.
# Example generation: openssl rand -base64 32. Never commit real keys.
AUTH_SIGNING_KEY=
CSRF_KEY=

# Absolute private directory, mode 0700; back up together with PostgreSQL.
FILE_STORAGE_DIR=
# Poppler pdfinfo executable; defaults to PATH lookup.
PDFINFO_BIN=
# Worker rendering Python; install scripts/export-requirements.lock first.
# Make defaults to the project .venv/bin/python. API and Worker share FILE_STORAGE_DIR.
EXPORT_PYTHON=

# Optional personal AI settings: separate persistent AES-256 key, NOT a provider key.
# Set both, or leave both empty. Generate once; retain across restarts. See docs/development/ai-settings.md.
CREDENTIAL_MASTER_KEY=
CREDENTIAL_KEY_VERSION=
