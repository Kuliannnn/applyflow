{
  "name": "applyflow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests vite.config.ts",
    "format:check": "prettier --check src tests vite.config.ts",
    "test:browser": "node tests/browser-flow.mjs",
    "test:ai-browser": "node tests/ai-settings-browser.mjs",
    "test:live-browser": "node tests/live-generation-browser.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
